[configuration]
entry_symbol = "car_studio_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]
android.debug.arm64 = "res://bin/android/libcarstudio.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/android/libcarstudio.android.template_release.arm64.so"
windows.debug.x86_64 = "res://bin/carstudio.windows.template_debug.x86_64.dll"
linux.debug.x86_64 = "res://bin/libcarstudio.linux.template_debug.x86_64.so"
